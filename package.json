{
  "name": "epicdevler_portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run chakra:typegen && next build",
    "start": "next start",
    "lint": "eslint",
    "chakra:typegen": "pnpm dlx @chakra-ui/cli typegen src/app/theme/theme.ts",
    "chakra:i-snippets": "bash ./scripts/chakra-snippet.sh",
    "init-base-template": "git remote add upstream https://github.com/epicdevler/website_template.git",
    "update-from-base-template": "git pull upstream main",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "^5.9.1",
    "@vercel/analytics": "^1.1.1",
    "@vercel/speed-insights": "^1.1.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.37.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  }
}
